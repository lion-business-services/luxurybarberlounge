# -----------------------------------------------------------------------------
# Luxury Barber Lounge environment template
# Copy to .env.local for local development. Never commit real credentials.
# -----------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.theluxurybarberlounge.com
NODE_ENV=development
CRON_SECRET=

# Supabase public browser values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only value
SUPABASE_SERVICE_ROLE_KEY=

# Square. Keep access token and webhook key server-only.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-07-15
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3000/api/square/webhooks
NEXT_PUBLIC_SQUARE_BOOKING_URL=

# Email provider adapter
EMAIL_PROVIDER=development
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Luxury Barber Lounge <info@theluxurybarberlounge.com>
EMAIL_REPLY_TO=info@theluxurybarberlounge.com

# SMS provider adapter
SMS_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# AI provider adapter. Core business operations never require AI.
AI_PROVIDER=development
AI_PROVIDER_API_KEY=
AI_MODEL=

# Analytics. All are optional and must be loaded consent-aware.
NEXT_PUBLIC_VERCEL_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# Portal demo access. Leave false in production unless intentionally reviewing
# the seeded, clearly marked demonstration dashboards.
NEXT_PUBLIC_PORTAL_DEMO_MODE=false

# Public feature flags
NEXT_PUBLIC_FEATURE_LIVE_SQUARE=false
NEXT_PUBLIC_FEATURE_SQUARE_BOOKINGS=false
NEXT_PUBLIC_FEATURE_SQUARE_LIVE_BOOKING=false
NEXT_PUBLIC_FEATURE_WALK_IN_QUEUE=false
NEXT_PUBLIC_FEATURE_KIOSK=false
NEXT_PUBLIC_FEATURE_MEMBERSHIPS=true
NEXT_PUBLIC_FEATURE_MEMBERSHIP_BILLING=false
NEXT_PUBLIC_FEATURE_GIFT_CARDS=false
NEXT_PUBLIC_FEATURE_LOYALTY=false
NEXT_PUBLIC_FEATURE_PRODUCTS=false
NEXT_PUBLIC_FEATURE_AI_CONCIERGE=true
NEXT_PUBLIC_FEATURE_AI_ADMIN=false
NEXT_PUBLIC_FEATURE_SMS=false
NEXT_PUBLIC_FEATURE_WHATSAPP=false
NEXT_PUBLIC_FEATURE_BROWSER_NOTIFICATIONS=false
NEXT_PUBLIC_FEATURE_ADVANCED_ANALYTICS=false
NEXT_PUBLIC_FEATURE_MULTI_LOCATION=false
NEXT_PUBLIC_FEATURE_EVENT_BOOKING=true
NEXT_PUBLIC_FEATURE_PAYOUT_EXPORT=false
NEXT_PUBLIC_FEATURE_SPANISH=true
NEXT_PUBLIC_FEATURE_ADVANCED_COMMISSION=true
NEXT_PUBLIC_FEATURE_EXPERIMENTAL_3D_HERO=true
