# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.theluxurybarberlounge.com
NODE_ENV=development
INITIAL_OWNER_EMAIL=info@theluxurybarberlounge.com
CRON_SECRET=
NEXT_PUBLIC_PORTAL_DEMO_MODE=false

# Supabase public browser values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only value
SUPABASE_SERVICE_ROLE_KEY=

# Email / Resend
EMAIL_PROVIDER=development
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Luxury Barber Lounge <access@theluxurybarberlounge.com>
EMAIL_REPLY_TO=info@theluxurybarberlounge.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Luxury Barber Lounge <access@theluxurybarberlounge.com>
RESEND_REPLY_TO_EMAIL=info@theluxurybarberlounge.com

# Square. Keep access token and webhook key server-only.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-07-15
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3000/api/square/webhooks
NEXT_PUBLIC_SQUARE_BOOKING_URL=

# SMS
SMS_PROVIDER=development
SMS_PROVIDER_API_KEY=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# AI assistance. Advisory only.
AI_PROVIDER=disabled
AI_PROVIDER_API_KEY=
AI_MODEL=

# Feature flags. Queue and kiosk may be enabled after migration 202607310010 and shop setup.
# Square-dependent flags must stay false until real provider credentials and mappings pass QA.
NEXT_PUBLIC_FEATURE_LIVE_SQUARE=false
NEXT_PUBLIC_FEATURE_SQUARE_BOOKINGS=false
NEXT_PUBLIC_FEATURE_SQUARE_LIVE_BOOKING=false
NEXT_PUBLIC_FEATURE_WALK_IN_QUEUE=false
NEXT_PUBLIC_FEATURE_KIOSK=false
NEXT_PUBLIC_FEATURE_MEMBERSHIP_BILLING=false
NEXT_PUBLIC_FEATURE_SMS=false
NEXT_PUBLIC_FEATURE_AI_ADMIN=false
