# Square - enter sandbox credentials first, then production after validation
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-07-15
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
