# Required server automation protection
CRON_SECRET=
BOOKING_MANAGE_SECRET=

# Production feature gates. Keep Square live features disabled until sandbox validation passes.
NEXT_PUBLIC_FEATURE_LIVE_SQUARE=false
NEXT_PUBLIC_FEATURE_SQUARE_BOOKINGS=false
